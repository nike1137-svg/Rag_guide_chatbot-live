# 프록시 설정. 이 파일을 proxy.env 로 복사해서 값을 채운다.
# proxy.env 는 커밋하지 않는다.
#
# 이미 환경변수가 설정돼 있으면 그쪽이 이긴다. 이 파일은 빈 자리만 채운다.

# 프록시가 듣는 포트
PROXY_PORT=8787

# 뒤에 있는 Ollama
OLLAMA_URL=http://localhost:11434

# 접속을 허용할 사이트 주소. 쉼표로 구분한다. * 는 쓰지 않는다.
# 개발 중에는 로컬 개발 서버만, 배포 후에는 실사용판 주소를 추가한다.
#   예: http://localhost:5173,https://chat.example.com
ALLOWED_ORIGINS=http://localhost:5173

# IP당 분당 요청 수. 질문 1건이 embed 1 + chat 1 이므로 30이면 약 15질문.
RATE_PER_MIN=30

# 요청 본문 상한(byte)
MAX_BODY=16384
