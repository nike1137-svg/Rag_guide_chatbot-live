# 이음이 빌드 환경변수
#
# 이 파일은 설명용이다. 실제 값은 `.env.live` 에 넣고, 그 파일은 커밋하지 않는다.
# 값을 하나도 주지 않으면 제출용(GitHub Pages + 사용자 PC의 로컬 Ollama) 동작 그대로다.
#
#   제출용   : npm run build:submit   (환경변수를 전부 지우고 빌드)
#   실사용판 : npm run build:live     (.env.live 를 읽어서 빌드)

# 답변·임베딩을 요청할 주소.
#   기본값 http://localhost:11434  (사용자 PC의 Ollama를 브라우저가 직접 호출)
#   실사용판은 Cloudflare Tunnel 주소를 넣는다. 예: https://api.example.com
VITE_OLLAMA_URL=

# 사이트가 올라가는 경로.
#   기본값 /Rag_guide_chatbot/  (GitHub Pages 하위 경로)
#   실사용판은 도메인 루트이므로 /
VITE_BASE=

# 연결 상태를 확인할 경로.
#   기본값 /api/tags     (Ollama가 직접 주는 모델 목록)
#   실사용판 /api/health (프록시가 판정 결과만 요약해 준다. 모델 목록은 감춘다)
VITE_HEALTH_PATH=

# 자동판정(LLM-as-a-Judge) 버튼 노출.
#   기본값 켜짐. off 로 두면 버튼을 감춘다(어르신용 화면에는 불필요)
VITE_JUDGE=

# 프롬프트에 넣는 근거 개수.
#   기본값 6. 검색 자체는 그대로 두고 모델에게 읽히는 양만 줄인다.
#   i5-10210U 실측: 6건이면 첫 글자까지 33초, 3건이면 19초.
VITE_CONTEXT_K=

# 모델을 메모리에 붙잡아 두는 시간.
#   비우면 Ollama 기본값(5분). 실사용판은 30m 으로 콜드 로딩을 막는다.
VITE_KEEP_ALIVE=

# 실사용판 여부. 1 이면 "Ollama를 설치하세요" 안내 대신 서버 안내 문구를 쓴다.
#   (문구 분기는 Phase 5에서 연결한다)
VITE_HOSTED=
